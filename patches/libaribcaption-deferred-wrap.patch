+    // the wrap is deferred until the next character is written. Otherwise a full line followed by APR
+    // would move down two lines, which is what broadcasters (e.g. ISDB-Tb in Brazil) rely on not happening.
+    if (active_pos_x_ >= display_area_start_x_ + display_area_width_) {
+        pending_wrap_ = true;
+    }
+}
+
+void DecoderImpl::ResolvePendingWrap() {
+    if (!pending_wrap_) {
+        return;
+    }
+    pending_wrap_ = false;
+    active_pos_x_ = display_area_start_x_;
+    MoveRelativeActivePos(0, 1);
+}
