+void DecoderImpl::AdvanceActivePosAfterCharacter() {
+    if (active_pos_x_ < 0 || active_pos_y_ < 0) {
+        SetAbsoluteActivePos(0, 0);
+    }
+
+    active_pos_inited_ = true;
+    active_pos_x_ += section_width();
+
